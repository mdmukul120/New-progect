# The vercel-php runtime copies the whole repository into the function bundle,
# so application code (src/, templates/, config/, database/, public/) must stay.
# Only local tooling, caches and generated data are excluded.

.cache/
node_modules/
vendor/
tools/
storage/
database/*.sqlite
database/*.sqlite-wal
database/*.sqlite-shm
*.md
.env
.env.local
.git/
.htaccess
public/.htaccess
public/router.php
vercel.json
