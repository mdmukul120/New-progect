# ------------------------------------------------------------------
# MovieLinkBD – environment template.  Copy to ".env" and edit.
# ------------------------------------------------------------------

APP_ENV=production
APP_DEBUG=0
APP_URL=https://pzpn8a.movielinkbd.at
APP_TIMEZONE=Asia/Dhaka
# Full local path of the application root (no trailing slash).
BASE_PATH=

# ---------------- storage ----------------
# Where logs/cache live. Leave empty for <project>/storage; serverless hosts
# (Vercel/Lambda) get /tmp automatically because the bundle is read-only.
# Admin sessions are stored in the database, not on disk.
STORAGE_PATH=

# ---------------- database ----------------
# sqlite  -> zero-config, file based (default for local work)
# mysql   -> set DB_HOST/DB_NAME/DB_USER/DB_PASS below
# pgsql   -> PostgreSQL / Supabase (used by the Vercel deployment)
DB_DRIVER=sqlite
DB_SQLITE_PATH=database/movielinkbd.sqlite

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=movielinkbd
DB_USER=root
DB_PASS=
DB_CHARSET=utf8mb4

# PostgreSQL only — a full connection string wins over the parts above.
# postgresql://postgres.<ref>:<password>@aws-1-ap-southeast-1.pooler.supabase.com:5432/postgres
DB_URL=
DB_SSLMODE=require

# ---------------- remote setup ----------------
# Enables GET /setup?token=... which applies the schema and seeds an empty
# database (there is no shell on Vercel). Leave empty to disable the route.
SETUP_TOKEN=

# ---------------- admin ----------------
# Password is stored hashed in the "settings" table after the first
# `php bin/console.php admin:password` run. This value is only used to
# bootstrap that first hash.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-now
ADMIN_SESSION_HOURS=12

# ---------------- branding ----------------
SITE_NAME=MovieLinkBD
SITE_TAGLINE=বাংলা • হিন্দি • সাউথ • K/J/C ড্রামা • অ্যানিমে
SITE_DESCRIPTION=MovieLinkBD — HD movies, web series, anime and K/J/C drama. Fast, clean and completely ad-free.
SOCIAL_FACEBOOK=https://www.facebook.com/groups/1423779586288739
SOCIAL_TELEGRAM=https://t.me/movielinkbdofficial

# ---------------- features ----------------
# "0" turns the whole ad system off (recommended: ads are disabled by design).
ADS_ENABLED=0
RATE_LIMIT_PER_MINUTE=90
