# --- অ্যাডমিন লগইন ---
ADMIN_PASSWORD=change-me-please
AUTH_SECRET=long-random-string

# --- স্টোরেজ ড্রাইভার: local | supabase ---
STORAGE_DRIVER=local
DATA_DIR=.data

# --- ডোমেইন রাউটিং ---
# আপনার রুট ডোমেইন (wildcard সাবডোমেইনের জন্য), যেমন yoursite.xyz
ROOT_DOMAIN=
# সাবডোমেইন না থাকলে (যেমন মুকুল.পাতা.বাংলা) সব রিকোয়েস্ট এই সাইটে যাবে
DEFAULT_SITE=

# --- Supabase (STORAGE_DRIVER=supabase হলে) ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=sitehub
